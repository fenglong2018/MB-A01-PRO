{
    "folders": [
        {
            "name": "gcc-rt-cursor",
            "path": "."
        }
    ],
    "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/arm-none-eabi-gcc",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-arm",
        "C_Cpp.intelliSenseEngine": "default",
        "files.associations": {
            "*.h": "c",
            "*.c": "c"
        }
    },
    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools",
            "ms-vscode-remote.remote-wsl"
        ]
    }
}
